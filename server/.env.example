MONGODB_URI="mongodb://127.0.0.1:27017/recruitflow"
JWT_SECRET="change-this-to-a-real-secret-before-deploying"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# שליחת מיילים - "שכחתי סיסמה" (ראי server/src/mailer.ts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="RecruitFlow <your-email@gmail.com>"
